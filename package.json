{
  "name": "@cplieger/deadset-ts",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "Deterministic dead-code analysis for TypeScript, class and type members included",
  "license": "GPL-3.0-or-later",
  "bin": {
    "deadset-ts": "./dist/bin/deadset-ts.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest --run",
    "lint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "dependencies": {
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cplieger/deadset-ts.git"
  },
  "homepage": "https://github.com/cplieger/deadset-ts",
  "bugs": {
    "url": "https://github.com/cplieger/deadset-ts/issues"
  },
  "author": "cplieger <917744+cplieger@users.noreply.github.com>",
  "keywords": [
    "dead-code",
    "static-analysis",
    "typescript",
    "unused-exports",
    "unused-members",
    "cli"
  ],
  "files": [
    "LICENSE",
    "NOTICE",
    "dist/",
    "src/",
    "!src/**/*.test.ts",
    "jsr.json"
  ]
}
