    "entry_files": [],
    "component_extensions": [".vue", ".svelte", ".astro"],
    "disabled_conventions": [],
    "injection_registrations": [],
    "lifecycle_contracts": [],
    "serializers": []
  },
  "provenance": {
    "contract_version": "default",
    "target.kind": "repository: repository.json",
    "analysis.languages": "repository: repository.json",
    "analysis.min_confidence": "default",
    "analysis.generated_files": "default",
    "analysis.consumer_tests": "default",
    "analysis.configurations": "repository: repository.json",
    "analysis.matrix.complete": "repository: repository.json",
    "analysis.template_dirs": "default",
    "analysis.template_delimiters": "default",
    "consumers.complete": "default",
    "roots.patterns": "default",
    "severity": "default",
    "exemptions.disabled": "default",
    "reporters.formats": "default",
    "reporters.sort": "default",
    "reporters.cascade": "default",
    "reporters.max_findings": "default",
    "reporters.fail_on": "default",
    "providers.analyzers": "default",
    "ts.test_files": "default",
    "ts.entry_files": "default",
    "ts.component_extensions": "default",
    "ts.disabled_conventions": "default",
    "ts.injection_registrations": "default",
    "ts.lifecycle_contracts": "default",
    "ts.serializers": "default"
