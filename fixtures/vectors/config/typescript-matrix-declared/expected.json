{
  "contract_version": "6.0.0",
  "target": { "kind": "application" },
  "analysis": {
    "languages": ["ts"],
    "min_confidence": "probable",
    "generated_files": "exclude",
    "consumer_tests": "test",
    "configurations": [
      { "id": "tsconfig.json", "project": "tsconfig.json" },
      { "id": "packages/app/tsconfig.json", "project": "packages/app/tsconfig.json" }
    ],
    "matrix": { "complete": true },
    "template_dirs": [],
    "template_delimiters": { "left": "{{", "right": "}}" }
  },
  "consumers": { "complete": false },
  "roots": { "patterns": [] },
  "severity": {},
  "exemptions": { "disabled": [] },
  "reporters": {
    "formats": ["text"],
    "sort": "position",
    "cascade": "roots",
    "max_findings": 0,
    "fail_on": "deny"
  },
  "providers": {
    "analyzers": [
      { "name": "deadset-go", "languages": ["go"], "command": "deadset-go" },
      { "name": "deadset-ts", "languages": ["ts"], "command": "deadset-ts" }
    ]
  },
  "go": {},
  "ts": {
