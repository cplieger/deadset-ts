{
  "contract_version": "7.0.0",
  "target": { "kind": "library" },
  "analysis": {
    "languages": [],
    "min_confidence": "possible",
    "generated_files": "include",
    "consumer_tests": "test",
    "configurations": [],
    "matrix": { "complete": false },
    "template_dirs": [],
    "template_delimiters": { "left": "{{", "right": "}}" }
  },
  "consumers": { "complete": false },
  "roots": {
    "patterns": [
      "go://example.com/app#Catalog.*",
      "go://example.com/app/internal/*#*",
      "ts://@example/app/src/generated/*.ts#*"
    ]
  },
  "severity": { "DS1101": "allow", "DS1201": "warn" },
  "exemptions": { "disabled": [] },
  "reporters": {
    "formats": ["text"],
    "sort": "position",
    "cascade": "roots",
    "max_findings": 0,
    "fail_on": "warn"
  },
  "providers": {
    "analyzers": [
      { "name": "deadset-go", "languages": ["go"], "command": "deadset-go" },
      { "name": "deadset-ts", "languages": ["ts"], "command": "deadset-ts" }
    ]
  },
  "go": {},
  "ts": {
    "test_files": ["**/*.test.{ts,tsx,mts,cts}", "**/*.test-d.{ts,tsx,mts,cts}", "**/*.spec-d.{ts,tsx,mts,cts}", "**/*.spec.*", "**/__tests__/**", "**/__mocks__/**", "**/test-d/**"],
    "entry_files": [],
    "component_extensions": [".vue", ".svelte", ".astro"],
    "disabled_conventions": [],
    "injection_registrations": [],
    "lifecycle_contracts": [],
    "serializers": []
  },
  "provenance": {
    "contract_version": "default",
    "target.kind": "repository: repository.json",
    "analysis.languages": "default",
    "analysis.min_confidence": "flag: --min-confidence",
    "analysis.generated_files": "central: central.json",
    "analysis.consumer_tests": "default",
    "analysis.configurations": "default",
    "analysis.matrix.complete": "default",
    "analysis.template_dirs": "default",
    "analysis.template_delimiters": "default",
    "consumers.complete": "default",
    "roots.patterns": "repository: repository.json",
    "severity.DS1101": "repository: repository.json",
    "severity.DS1201": "central: central.json",
    "exemptions.disabled": "default",
    "reporters.formats": "default",
    "reporters.sort": "default",
    "reporters.cascade": "default",
    "reporters.max_findings": "default",
    "reporters.fail_on": "central: central.json",
    "providers.analyzers": "default",
    "ts.test_files": "default",
    "ts.entry_files": "default",
    "ts.component_extensions": "default",
    "ts.disabled_conventions": "default",
    "ts.injection_registrations": "default",
    "ts.lifecycle_contracts": "default",
    "ts.serializers": "default"
  }
}
