{
  "name": "test-file-intra-function-parts",
  "description": "The parts of a TypeScript test file's declarations are judged in the run that counts test references, as Go's are: a test-file helper a test calls has its unread parameter reported, and a test's store nothing reads before the next one is reported. A test-file helper nothing calls is reported whole as an unreferenced declaration, so its unread parameter is not reported.",
  "languages": [
    "ts"
  ],
  "target_kind": "application",
  "expect": [
    {
      "symbol": "HelperUnread",
      "report": "DS1801",
      "confidence": "certain",
      "reachability_class": "certain",
      "symbol_kind": "parameter",
      "details": {
        "overlap": [
          "tsc --noUnusedParameters",
          "@typescript-eslint/no-unused-vars"
        ]
      }
    },
    {
      "symbol": "DeadHelper",
      "report": "DS1002",
      "confidence": "certain",
      "reachability_class": "certain",
      "symbol_kind": "function",
      "liveness_relation": "reference-counting",
      "component": {
        "root": true
      }
    },
    {
      "symbol": "DeadHelperUnread",
      "report": "none"
    },
    {
      "symbol": "FirstStore",
      "report": "DS1807",
      "confidence": "certain",
      "reachability_class": "certain",
      "symbol_kind": "store",
      "details": {
        "overlap": [
          "eslint no-useless-assignment",
          "@typescript-eslint/no-unused-vars"
        ]
      }
    },
    {
      "symbol": "testLive",
      "report": "none"
    }
  ]
}
