{
  "name": "intra-function-parts",
  "description": "One part per kind of the intra-function group that both languages share is reported: a parameter its body never reads, a result every call drops, the statement after a return, the store nothing reads before the next one, and the case an earlier case of the same switch already answers. Beside each sits a part of the same shape that is not reported, so the fixture pins the boundary of each kind rather than the presence of a finding.",
  "languages": ["go", "ts"],
  "target_kind": "application",
  "expect": [
    {
      "symbol": "UnreadParameter",
      "report": "DS1801",
      "confidence": "certain",
      "reachability_class": "certain",
      "symbol_kind": "parameter"
    },
    {
      "symbol": "ReadParameter",
      "report": "none"
    },
    {
      "symbol": "DroppedResult",
      "report": "DS1803",
      "confidence": "certain",
      "reachability_class": "certain",
      "symbol_kind": "result"
    },
    {
      "symbol": "ReadResult",
      "report": "none"
    },
    {
      "symbol": "UnreachableStatement",
      "report": "DS1805",
      "confidence": "certain",
      "reachability_class": "certain",
      "symbol_kind": "statement"
    },
    {
      "symbol": "DeadStore",
      "report": "DS1807",
      "confidence": "certain",
      "reachability_class": "certain",
      "symbol_kind": "store"
    },
    {
      "symbol": "LiveStore",
      "report": "none"
    },
    {
      "symbol": "ReachableCase",
      "report": "none"
    },
    {
      "symbol": "UnreachableCase",
