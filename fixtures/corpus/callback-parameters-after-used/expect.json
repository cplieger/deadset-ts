{
  "name": "callback-parameters-after-used",
  "description": "A function used as a value may be passed more arguments than it declares, so a callback's unread parameter is reported only when no parameter after it is read, while an unread parameter before the last read one is not. A function whose signature is free has every unread parameter reported, and no name exempts a parameter, so one whose name starts with an underscore is reported too. A callback's parameter that is an object binding pattern reads the properties it names from the argument, so neither it nor any name it binds is reported. A declared function's parameter that destructures its argument is judged by the names it binds: each unread name is reported, except a name beside a rest element of the same object pattern. A rest parameter is judged as the last parameter, and a this parameter receives no argument and is never reported.",
  "languages": [
    "ts"
  ],
  "target_kind": "application",
  "expect": [
    {
      "symbol": "Unused",
      "report": "DS1801",
      "confidence": "certain",
      "reachability_class": "certain",
      "symbol_kind": "parameter",
      "details": {
        "overlap": [
          "tsc --noUnusedParameters",
          "@typescript-eslint/no-unused-vars"
        ]
      }
    },
    {
      "symbol": "First",
      "report": "none"
    },
    {
      "symbol": "Second",
      "report": "none"
